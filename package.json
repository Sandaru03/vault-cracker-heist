{
  "name": "vault-cracker-heist",
  "version": "1.0.0",
  "description": "Vault Cracker - Cyber-Heist Web Application Monorepo",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client"
  },
  "keywords": [
    "cyberpunk",
    "heist",
    "vault-cracker",
    "full-stack",
    "react",
    "express",
    "mysql"
  ],
  "author": "Vault Cracker Operations",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
